# Copy to .env.local and fill in your values.
# .env (committed) holds defaults; .env.local (gitignored) holds your secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-to-a-random-32-char-string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://lenslore:lenslore@127.0.0.1:5432/lenslore?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> aws ###
AWS_REGION=eu-west-1
AWS_S3_BUCKET=lenslore-photos-dev

# Leave empty when running on EC2/ECS with an instance/task IAM role —
# the AWS SDK picks up credentials from the metadata service automatically.
# Only set these when running locally without `aws configure`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
###< aws ###

###> lambda ###
# After `terraform apply`, copy ARNs from `terraform output`.
LAMBDA_STORY_ARN=arn:aws:lambda:eu-west-1:000000000000:function:lenslore-dev-story-generator
LAMBDA_GO_DEEPER_ARN=arn:aws:lambda:eu-west-1:000000000000:function:lenslore-dev-go-deeper
###< lambda ###

###> anthropic ###
# Only used by tools that don't go through the Lambdas. The Lambdas read
# the key from Secrets Manager; this is a fallback for direct local use.
ANTHROPIC_API_KEY=
###< anthropic ###
