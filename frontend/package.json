    "@aurelia/vite-plugin": "2.0.0-rc.1",
    "@types/jsdom": "^28.0.1",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
